generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  key       String   @unique
  createdAt DateTime @default(now())
  columns   Column[]
}

// A board column / swimlane (e.g. Open, Analysing, Analysed).
// `board` groups columns into one of the three boards: analysis | development | acceptance.
model Column {
  id        String   @id @default(cuid())
  name      String
  board     String   @default("analysis")
  order     Int
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets   Ticket[]

  @@index([projectId])
  @@index([projectId, board])
}

model Ticket {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int
  columnId    String
  column      Column   @relation(fields: [columnId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([columnId])
}
