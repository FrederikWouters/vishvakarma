# Vishvakarma environment variables (copy to .env; do NOT commit real values).

# Postgres connection string (VSK-32: the app runs on Postgres, not SQLite).
# Local dev: run a Postgres and point this at it, e.g.
#   docker run --name vsk-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
#   then create the databases: vishvakarma_dev (app) and vishvakarma_test (tests).
# Hosted: the Neon pooled URL (?sslmode=require) is set in Vercel, never here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vishvakarma_dev"

# The test suite uses its own throwaway database, overridable via DATABASE_URL
# when running `npm test`. Default: postgresql://postgres:postgres@localhost:5432/vishvakarma_test
# (see vitest.config.ts). tests/global-setup.ts RESETS this DB on every run.

# --- Access gate (VSK-18) ---------------------------------------------------
# Shared password for the whole app. It doubles as the HMAC signing key for the
# session cookie, so this is the ONLY secret the gate needs.
#
# Behaviour:
#   - UNSET (as here / in local dev) => the gate is INERT and every request is
#     allowed. This is intentional so local dev stays open and you cannot lock
#     yourself out.
#   - SET (in the hosted environment) => the gate activates automatically; all
#     pages and /api/* routes require a valid session cookie obtained via /login.
#
# The only deploy step to turn on auth is setting this variable on the host.
# Rotating it invalidates all existing sessions (fine for a single user).
# VSK_ACCESS_PASSWORD="choose-a-strong-password"
